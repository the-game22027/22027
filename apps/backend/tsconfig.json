{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "rootDir": "./",
    "sourceMap": true,
    "removeComments": true,
    "incremental": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strict": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"],
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@modules/*": ["./src/modules/*"],
      "@generated/*": ["./src/generated/*"]
    }
  },
  "include": ["src/**/*", "test/**/*", "scripts/**/*", "prisma.config.ts", "jest*.config.ts"],
  // Written by the e2e setup for one test run (test/support/swagger-metadata.ts); a stale copy must not break builds.
  "exclude": ["node_modules", "dist", "src/generated/swagger-metadata.ts"]
}
