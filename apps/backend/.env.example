# Copy to .env for local development. Values here are fake and safe to commit.
# Validated at boot by src/shared/infrastructure/config/app-config.ts.

NODE_ENV=development
LOG_LEVEL=info
API_PORT=3000
WORKER_PORT=3100

# docker compose up -d postgres redis
DATABASE_URL=postgresql://game:game@localhost:5440/app
REDIS_URL=redis://localhost:6379

HTTP_BODY_LIMIT=100kb
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100
OUTBOX_LEASE_MS=60000
OUTBOX_PUBLISH_TIMEOUT_MS=5000
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_RETRY_BASE_MS=1000
OUTBOX_RETRY_MAX_MS=300000

# Access tokens (ES256). Fill with: npm run keys:generate
JWT_PRIVATE_KEY=""
JWT_KEY_ID=
# Optional, during a key rotation only: the old public key and its key id stay valid for verification.
# JWT_PREVIOUS_PUBLIC_KEY=
# JWT_PREVIOUS_KEY_ID=
JWT_ISSUER=the-game-api
JWT_AUDIENCE=the-game-app
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_SLIDING_DAYS=60
REFRESH_TOKEN_ABSOLUTE_DAYS=180

# Google sign-in: OAuth client ids of the Android, iOS and web apps, comma-separated.
# Empty in development: use POST /v1/_dev/auth/sign-in instead.
GOOGLE_CLIENT_IDS=

# Allowed username format. The rule is still open (DEC-49).
USERNAME_PATTERN=^[A-Za-z0-9_]{3,20}$
# DELETE /v1/me requires a sign-in at most this old (DEC-50).
ACCOUNT_DELETION_RECENT_SIGN_IN_SECONDS=600

# Highest goal count allowed for either team in an exact-score pick (DEC-51).
PREDICTION_MAX_GOALS=20

RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_USER_SEARCH_PER_MINUTE=30
RATE_LIMIT_FRIEND_REQUESTS_PER_HOUR=30
# Reverse proxies in front of the API. 0 = ignore X-Forwarded-For, which clients can fake.
TRUST_PROXY_HOPS=0

# Football data sync (worker). The mock provider reads its seed from this folder.
FOOTBALL_SYNC_INTERVAL_SECONDS=3600
FOOTBALL_SYNC_PAST_DAYS=30
FOOTBALL_SYNC_FUTURE_DAYS=60
MOCK_FOOTBALL_SEED_DIR=prisma/seed/football

# Battle rules and timers (ADR-0018). The dev file holds placeholder values; production refuses it.
BATTLE_CONFIG_PATH=config/battles.dev.json

# Leaderboard calendar: time zone, week start, seasons (03 §5.6). Season dates are placeholders; production refuses the dev file.
LEADERBOARD_CONFIG_PATH=config/leaderboards.dev.json
