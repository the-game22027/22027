// Owned by the question-bank module (docs/architecture/02-database.md §4.6).

enum QuestionStatus {
  DRAFT
  APPROVED
  PUBLISHED
  DISABLED

  @@map("question_status")
}

/// Which game a battle (and a round of content) plays (ADR-0015).
enum BattleGameType {
  BUZZER
  CAREER
  WHO_IS_PLAYER
  GRID
  MINES
  AUCTION
  VAULT

  @@map("battle_game_type")
}

/// What a typed answer must be: a catalog entity of this kind, or a number (08 §4).
enum AnswerKind {
  PLAYER
  CLUB
  NATIONAL_TEAM
  COUNTRY
  COMPETITION
  COACH
  NUMBER

  @@map("answer_kind")
}

model QuestionCategory {
  id       String  @id @db.Uuid
  slug     String  @unique
  names    Json
  parentId String? @map("parent_id") @db.Uuid

  parent    QuestionCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  QuestionCategory[] @relation("CategoryTree")
  questions Question[]

  @@map("question_categories")
}

model QuestionImportBatch {
  id               String   @id @db.Uuid
  bundleVersion    String   @unique @map("bundle_version")
  checksum         String
  /// Checksum of catalog.jsonl when the bundle carried one.
  catalogChecksum  String?  @map("catalog_checksum")
  generatorVersion String   @map("generator_version")
  kbVersion        String   @map("kb_version")
  status           String
  /// How many questions each import outcome had (inserted, unchanged, replaced, ...).
  stats            Json?
  importedAt       DateTime @map("imported_at") @db.Timestamptz(3)

  questions Question[]

  @@map("question_import_batches")
}

model Question {
  id                   String          @id @db.Uuid
  externalKey          String          @map("external_key")
  /// Goes up by one when changed content replaces a question that could already have been served.
  keyVersion           Int             @default(1) @map("key_version")
  contentHash          String          @map("content_hash")
  /// SINGLE_CHOICE (legacy, never served) or GAME.
  type                 String          @default("SINGLE_CHOICE")
  gameType             BattleGameType? @map("game_type")
  answerKind           AnswerKind?     @map("answer_kind")
  /// The game-specific part of the round (08 §4), read whole, never queried inside.
  content              Json?
  categoryId           String          @map("category_id") @db.Uuid
  difficulty           Int             @db.SmallInt
  calibratedDifficulty Decimal?        @map("calibrated_difficulty") @db.Decimal
  status               QuestionStatus  @default(DRAFT)
  availableLocales     String[]        @map("available_locales")
  provenance           Json
  licenseFlags         String[]        @default([]) @map("license_flags")
  validUntil           DateTime?       @map("valid_until") @db.Timestamptz(3)
  importBatchId        String          @map("import_batch_id") @db.Uuid
  publishedAt          DateTime?       @map("published_at") @db.Timestamptz(3)
  disabledAt           DateTime?       @map("disabled_at") @db.Timestamptz(3)
  disabledReason       String?         @map("disabled_reason")
  createdAt            DateTime        @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @map("updated_at") @db.Timestamptz(3)

  category     QuestionCategory      @relation(fields: [categoryId], references: [id])
  importBatch  QuestionImportBatch   @relation(fields: [importBatchId], references: [id])
  translations QuestionTranslation[]
  options      QuestionOption[]
  answers      QuestionAnswer[]
  battleRounds BattleRound[]
  stats        QuestionStats?
  reports      QuestionReport[]

  @@unique([externalKey, keyVersion])
  @@index([status, difficulty, categoryId])
  @@index([status, gameType, difficulty, categoryId])
  @@index([availableLocales], type: Gin)
  @@map("questions")
}

model QuestionTranslation {
  questionId    String  @map("question_id") @db.Uuid
  locale        String
  text          String
  explanation   String?
  humanReviewed Boolean @default(false) @map("human_reviewed")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([questionId, locale])
  @@map("question_translations")
}

model QuestionOption {
  id         String  @id @db.Uuid
  questionId String  @map("question_id") @db.Uuid
  position   Int     @db.SmallInt
  isCorrect  Boolean @map("is_correct")
  entityRef  String? @map("entity_ref")

  question     Question                    @relation(fields: [questionId], references: [id], onDelete: Cascade)
  translations QuestionOptionTranslation[]

  @@unique([questionId, position])
  @@map("question_options")
}

model QuestionOptionTranslation {
  optionId String @map("option_id") @db.Uuid
  locale   String
  text     String

  option QuestionOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@id([optionId, locale])
  @@map("question_option_translations")
}

/// Accepted answers of a round: slot 0 for reveal games, 0..8 for grid cells (08 §5.3).
model QuestionAnswer {
  questionId String @map("question_id") @db.Uuid
  slot       Int    @db.SmallInt
  entityId   String @map("entity_id") @db.Uuid

  question Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  entity   AnswerEntity @relation(fields: [entityId], references: [id])

  @@id([questionId, slot, entityId])
  @@index([entityId])
  @@map("question_answers")
}

/// The answer catalog: every entity a typed answer can be (08 §5).
model AnswerEntity {
  id             String     @id @db.Uuid
  /// e.g. wikidata:Q11571; the upsert key on import.
  externalRef    String     @unique @map("external_ref")
  kind           AnswerKind
  /// {en, ar} display names.
  names          Json
  /// Breaks ties between grid answers; from the pipeline (Wikipedia sitelinks).
  popularity     Int        @default(0)
  /// Normalized names and aliases (07 §5.7); what typed text is judged against (ADR-0021).
  searchForms    String[]   @map("search_forms")
  /// [{form, sharedBy}]: single words of the names that may count alone as an answer (ADR-0021).
  nameWords      Json       @default("[]") @map("name_words")
  /// The bundle version that last changed this entity.
  catalogVersion String     @map("catalog_version")
  /// ACTIVE, or HIDDEN when a newer catalog dropped it (kept because battle history points at it).
  status         String     @default("ACTIVE")
  updatedAt      DateTime   @map("updated_at") @db.Timestamptz(3)

  aliases       AnswerEntityAlias[]
  answers       QuestionAnswer[]
  battleActions BattleRoundAction[]

  @@index([kind])
  /// Finds the entity a typed text names exactly (08 §5.3 step 3).
  @@index([searchForms], type: Gin)
  @@map("answer_entities")
}

model AnswerEntityAlias {
  entityId String @map("entity_id") @db.Uuid
  locale   String
  alias    String

  entity AnswerEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@id([entityId, locale, alias])
  @@map("answer_entity_aliases")
}

/// Human play data per question, for difficulty calibration later (08 §5.7). Bots are not counted.
model QuestionStats {
  questionId      String   @id @map("question_id") @db.Uuid
  timesServed     Int      @default(0) @map("times_served")
  timesSolved     Int      @default(0) @map("times_solved")
  /// Wrong typed answers and grid claims across battles.
  wrongAnswers    Int      @default(0) @map("wrong_answers")
  /// Reveal games: with times_solved, the average step at which the question was solved.
  stepsToSolveSum Int      @default(0) @map("steps_to_solve_sum")
  updatedAt       DateTime @map("updated_at") @db.Timestamptz(3)

  question Question @relation(fields: [questionId], references: [id])

  @@map("question_stats")
}

/// BattleCompleted events already folded into question_stats (at-least-once dedup).
model QuestionStatsApplied {
  battleId  String   @id @map("battle_id") @db.Uuid
  appliedAt DateTime @map("applied_at") @db.Timestamptz(3)

  @@map("question_stats_applied")
}

/// A player says a question they were served is wrong (08 §5.7).
model QuestionReport {
  id         String   @id @db.Uuid
  questionId String   @map("question_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  reason     String
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  question Question @relation(fields: [questionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  /// One report per player per question; a repeat changes nothing.
  @@unique([questionId, userId])
  @@map("question_reports")
}
