enum PredictionStatus {
  ACTIVE
  VOID

  @@map("prediction_status")
}

enum PickType {
  RESULT
  EXACT_SCORE
  MOTM

  @@map("pick_type")
}

enum Outcome {
  HOME
  DRAW
  AWAY

  @@map("outcome")
}

model Prediction {
  id        String           @id @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  matchId   String           @map("match_id") @db.Uuid
  status    PredictionStatus @default(ACTIVE)
  revision  Int              @default(1)
  createdAt DateTime         @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime         @map("updated_at") @db.Timestamptz(3)

  user      User                 @relation(fields: [userId], references: [id])
  match     Match                @relation(fields: [matchId], references: [id])
  picks     PredictionPick[]
  revisions PredictionRevision[]

  @@unique([userId, matchId])
  @@index([matchId])
  @@index([userId, createdAt(sort: Desc)])
  @@map("predictions")
}

model PredictionPick {
  predictionId String   @map("prediction_id") @db.Uuid
  pickType     PickType @map("pick_type")
  outcome      Outcome?
  homeScore    Int?     @map("home_score") @db.SmallInt
  awayScore    Int?     @map("away_score") @db.SmallInt
  playerId     String?  @map("player_id") @db.Uuid

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)
  player     Player?    @relation(fields: [playerId], references: [id])

  @@id([predictionId, pickType])
  @@map("prediction_picks")
}

model PredictionRevision {
  id           String   @id @db.Uuid
  predictionId String   @map("prediction_id") @db.Uuid
  revision     Int
  picks        Json
  submittedAt  DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)
  requestId    String?  @map("request_id")

  prediction Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  @@unique([predictionId, revision])
  @@map("prediction_revisions")
}
