// Owned by shared/infrastructure (docs/architecture/02-database.md §4.13).

/// Transactional outbox: written in the same transaction as the state change, published to BullMQ by the worker.
model OutboxEvent {
  id            String    @id @db.Uuid
  type          String
  version       Int
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  occurredAt    DateTime  @map("occurred_at") @db.Timestamptz(3)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(3)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error")

  // Serves "unpublished, oldest first" (published_at IS NULL ORDER BY occurred_at).
  @@index([publishedAt, occurredAt])
  @@map("outbox_events")
}
