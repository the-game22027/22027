enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_DELETION
  DELETED

  @@map("user_status")
}

model User {
  id        String     @id @db.Uuid
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(3)

  profile         UserProfile?
  privacySettings UserPrivacySettings?

  // Prisma needs these for the FKs from auth tables; the users module never reads them.
  authIdentities         AuthIdentity[]
  sessions               Session[]
  predictions            Prediction[]
  battleSeats            BattleParticipant[]
  pointEntries           PointEntry[]
  leaderboardRows        LeaderboardEntry[]
  questionReports        QuestionReport[]
  sentFriendRequests     FriendRequest[]     @relation("SentFriendRequests")
  receivedFriendRequests FriendRequest[]     @relation("ReceivedFriendRequests")
  friendshipsAsLow       Friendship[]        @relation("FriendshipsAsLow")
  friendshipsAsHigh      Friendship[]        @relation("FriendshipsAsHigh")
  blocksMade             UserBlock[]         @relation("BlocksMade")
  blocksReceived         UserBlock[]         @relation("BlocksReceived")

  @@map("users")
}

model UserProfile {
  userId          String   @id @map("user_id") @db.Uuid
  displayName     String   @map("display_name")
  username        String?  @unique @db.Citext
  avatarUrl       String?  @map("avatar_url")
  locale          String   @default("ar")
  countryCode     String?  @map("country_code") @db.Char(2)
  favouriteTeamId String?  @map("favourite_team_id") @db.Uuid
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  favouriteTeam Team? @relation(fields: [favouriteTeamId], references: [id], onDelete: SetNull)

  @@map("user_profiles")
}

model UserPrivacySettings {
  userId               String   @id @map("user_id") @db.Uuid
  predictionVisibility String?  @map("prediction_visibility")
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_privacy_settings")
}
