// Owned by the social module (docs/architecture/02-database.md §4.12).

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED

  @@map("friend_request_status")
}

/// At most one PENDING request per pair, in either direction (partial unique index in the migration).
model FriendRequest {
  id          String              @id @db.Uuid
  requesterId String              @map("requester_id") @db.Uuid
  addresseeId String              @map("addressee_id") @db.Uuid
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime            @map("created_at") @db.Timestamptz(3)
  respondedAt DateTime?           @map("responded_at") @db.Timestamptz(3)

  requester User @relation("SentFriendRequests", fields: [requesterId], references: [id])
  addressee User @relation("ReceivedFriendRequests", fields: [addresseeId], references: [id])

  @@index([addresseeId, status])
  @@index([requesterId, status])
  @@map("friend_requests")
}

/// One row per pair: the lower user id first, so (a, b) and (b, a) can never both exist.
model Friendship {
  userLowId  String   @map("user_low_id") @db.Uuid
  userHighId String   @map("user_high_id") @db.Uuid
  createdAt  DateTime @map("created_at") @db.Timestamptz(3)

  userLow  User @relation("FriendshipsAsLow", fields: [userLowId], references: [id])
  userHigh User @relation("FriendshipsAsHigh", fields: [userHighId], references: [id])

  @@id([userLowId, userHighId])
  @@index([userHighId])
  @@map("friendships")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @map("created_at") @db.Timestamptz(3)

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id])
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id])

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}
